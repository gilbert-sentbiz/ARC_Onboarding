# ARC Server — 환경변수 예시
# 이 파일을 .env로 복사하고 값 수정: cp .env.example .env
# .env는 커밋하지 않는다 (크리덴셜 포함)

# ── DB (Postgres) ──
DB_NAME=arc_db
DB_USERNAME=arc_user
DB_PASSWORD=arc_pass          # 로컬: 임의값 / 회사: 사내 Postgres 크리덴셜

# ── Storage (MinIO 로컬 / 회사 S3) ──
S3_ENDPOINT=http://storage:9000   # 회사 환경: https://s3.ap-northeast-2.amazonaws.com 등
S3_BUCKET=arc-documents
S3_ACCESS_KEY=minio_access        # 회사 환경: IAM 키 또는 시크릿 매니저 참조
S3_SECRET_KEY=minio_secret

# ── 인증 ──
AUTH_MODE=otp                     # MVP 확정. 로컬: OTP 코드를 콘솔 로그로 출력
